#include<iostream>
#include<bits/stdc++.h>
int main(){
    int arr[5]={4,3,2,1,0};
    for(int i=0;i<5;i++){
        int j=i;
        while(j>0&&arr[j-1]>arr[j]){
            std::swap(arr[j-1],arr[j]);
            j--;
        }
    }
    for(int i=0;i<5;i++){
        std::cout<<arr[i]<<std::endl;
    }
}
