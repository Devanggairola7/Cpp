#include<iostream>
#include<bits/stdc++.h>
int main(){
    int arr[5]={4,3,2,1,0};
    int min=0;
    for(int i=0;i<4;i++){
        min=i;
        for(int j=i;j<5;j++){
            if(arr[j]<arr[min]){
                min=j;
            }
        }
        std::swap(arr[min],arr[i]);
    }
    for(int i=0;i<5;i++){
        std::cout<<arr[i]<<std::endl;
    }
}
