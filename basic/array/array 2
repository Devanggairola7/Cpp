#include<iostream>
int main(){
    int arr1[]={1, 2, 7,5, 4};
    int arr2[]={8, 4, 3, 2, 1};
    int z;
    int m= sizeof(arr1) / sizeof(arr1[0]);
    int n= sizeof(arr2) / sizeof(arr2[0]);
    if(m==n){
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(arr1[i]=arr2[j]){
                    z++;
                    break;
                }
                else{
                    continue;
                }
            }
        }
        if(z==m){
            std::cout<<"Equal";
        }
        else{
            std::cout<<"Unequal";
        }
    }
    else{
        std::cout<<"Unequal";
    }
}
