
#include <iostream>

int main() {
    int number=7;
    int flag=0;
    for(int i=3;i<=number/2;i++){
        if(number%i==0){
            flag=1;
            break;
        }
        else{
            continue;
        }
    }
    if(flag==1){
        std::cout<<"not a prime number";
    }

    return 0;
}
