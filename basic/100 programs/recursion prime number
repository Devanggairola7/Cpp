
#include <iostream>
using namespace std;
int recursion(int n,int z){
    int y=n/2;
    if(z>y){
        cout<<"yeah PRIME!";
        return 0;// the range is crossed 
    }
    else{
    if(n%z==0){
        cout<<"not prime";
        return 0;// getting out of the recursion trap
    }
    else{
        z++;// incremented to 4;
    }
  }
  return recursion(n,z);
}
int main() {
    recursion(6,3);
    return 0;
}
