#include <iostream>

int main() {
    int arr[4]={0,2,2,3};
    int x=2;
    int low =0,high =3;
    while (low<=high){
        int mid =low+(high-low)/2;
        if(arr[mid]==x){
            std::cout<<mid;
        }
        if(arr[mid]<x){
            low=mid+1;
        }
        else{
            high=mid-1;
        }
    }
    std::cout<<"Not present in the array";
    return 0;
}
